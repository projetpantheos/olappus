# ==========================================================================
# OLAPPUS — .gitignore
# Premier fichier du dépôt, écrit avant tout `git add` (gate G1).
# Règle : aucun secret, aucune donnée personnelle, aucun artefact de build.
# ==========================================================================

# --- Secrets et environnement ---------------------------------------------
.env
.env.*
!.env.example
*.local.env
secrets/
.secrets/
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
*.mobileprovision
google-services.json
GoogleService-Info.plist
service-account*.json
credentials*.json
client_secret*.json

# --- Dépendances ----------------------------------------------------------
node_modules/
.pnp
.pnp.js
.yarn/
.npm/

# --- Builds et artefacts --------------------------------------------------
dist/
build/
out/
web-build/
*.tsbuildinfo
.turbo/
.next/

# --- Expo / React Native --------------------------------------------------
.expo/
.expo-shared/
*.jks
*.aab
*.apk
*.ipa
ios/Pods/
android/.gradle/
android/app/build/
android/build/
.eas/

# --- Supabase -------------------------------------------------------------
supabase/.temp/
supabase/.branches/
supabase/logs/

# --- Bases locales et données ---------------------------------------------
# Aucune donnée réelle ni base locale ne doit être versionnée.
*.sqlite
*.sqlite3
*.db
*.db-journal
data/local/
fixtures/real/

# --- Tests et couverture --------------------------------------------------
coverage/
.nyc_output/
test-results/
playwright-report/

# --- Journaux -------------------------------------------------------------
# Les journaux peuvent contenir des jetons ou des données personnelles :
# ils ne sont jamais versionnés (voir SEC-34).
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Éditeurs et OS -------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.recommended.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- Divers ---------------------------------------------------------------
.cache/
tmp/
temp/
*.tmp
